@page "{id:int}"
@model DeLyseroedeSpejdere.Pages.Leader.EditModel
@{ ViewData["Title"] = "Rediger aktivitet"; }
<h1>Rediger aktivitet</h1>
<form method="post" class="card form">
    <div asp-validation-summary="ModelOnly"></div>
    <label asp-for="Input.Title"></label><input asp-for="Input.Title"/><span asp-validation-for="Input.Title"></span>
    <label asp-for="Input.Description"></label><textarea asp-for="Input.Description"></textarea><span asp-validation-for="Input.Description"></span>
    <label asp-for="Input.StartsAt"></label><input asp-for="Input.StartsAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"/><span asp-validation-for="Input.StartsAt"></span>
    <label asp-for="Input.EndsAt"></label><input asp-for="Input.EndsAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"/><span asp-validation-for="Input.EndsAt"></span>
    <label asp-for="Input.MaxParticipants"></label><input asp-for="Input.MaxParticipants" type="number"/><span asp-validation-for="Input.MaxParticipants"></span>
    <label asp-for="Input.MinAge"></label><input asp-for="Input.MinAge" type="number"/><span asp-validation-for="Input.MinAge"></span>
    <label asp-for="Input.RequiredBadge"></label><input asp-for="Input.RequiredBadge"/><span asp-validation-for="Input.RequiredBadge"></span>
    <div class="actions"><button class="btn" type="submit">Gem ændringer</button><a asp-page="/Leader/Index">Annuller</a></div>
</form>
