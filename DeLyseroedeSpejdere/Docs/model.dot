digraph ER {
  graph [rankdir=LR, bgcolor="white", pad=0.15, nodesep=0.6, ranksep=0.9];
  node [shape=record, fontname="DejaVu Sans", fontsize=10, style="rounded,filled", fillcolor="#f0f5f8", color="#41657a"];
  Users [label="{Users|Id (PK)\lUsername (UNIQUE)\lPasswordHash\lFullName\lRole\lAge\lBadges\l}"];
  Activities [label="{Activities|Id (PK)\lTitle\lDescription\lStartsAt / EndsAt\lMaxParticipants\lMinAge\lRequiredBadge\lLeaderId (FK)\l}"];
  Registrations [label="{Registrations|UserId (PK,FK)\lActivityId (PK,FK)\lRegisteredAt\l}"];
