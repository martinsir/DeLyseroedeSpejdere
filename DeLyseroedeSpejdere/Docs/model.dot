// De Lyseroede Spejdere - ER diagram med Crow's Foot kardinalitet
// Render: dot -Tpng -Gdpi=170 model.dot -o ER_diagram.png
// Symboler: || = praecis en, o< = nul til mange.
digraph ER {
  graph [bgcolor="white", rankdir=LR, splines=polyline, nodesep="1.0", ranksep="1.3", pad="0.45", outputorder=edgesfirst, fontname="Arial", fontsize=16, label="De Lyserøde Spejdere | ER-diagram (Crow's Foot)", labelloc=t, labeljust=c];
  node [shape=plain, fontname="Arial", fontsize=13];
  edge [color="#45647e", penwidth=1.9, fontname="Arial", fontsize=11, fontcolor="#38546a", arrowsize=1.1];

  Users [label=<
    <TABLE BORDER="1" COLOR="#59758c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff">
      <TR><TD BGCOLOR="#234866" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="17"><B>Users</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#275f95"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>Id</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#8f6026"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">Username</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">PasswordHash</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">FullName</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">Role</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">Age</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">Badges</TD></TR>
    </TABLE>>];
  Activities [label=<
    <TABLE BORDER="1" COLOR="#59758c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff">
      <TR><TD BGCOLOR="#234866" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="17"><B>Activities</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#275f95"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>Id</B></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">Title</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">Description</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">StartsAt</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">EndsAt</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">MaxParticipants</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">MinAge</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">RequiredBadge</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#a45033"><B>FK</B></FONT></TD><TD ALIGN="LEFT">LeaderId</TD></TR>
    </TABLE>>];
  Registrations [label=<
    <TABLE BORDER="1" COLOR="#59758c" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff">
      <TR><TD BGCOLOR="#234866" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="17"><B>Registrations</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#a45033"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><B>UserId</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#a45033"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><B>ActivityId</B></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">RegisteredAt</TD></TR>
    </TABLE>>];

  // Mange-side har en aaben cirkel for valgfri (0) og Crow's Foot for mange.
  // En-side har to streger for praecis en.
  Users -> Activities [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..*", label="leder opretter", labeldistance=2.5, minlen=2, weight=5];
  Users -> Registrations [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..*", label="bruger tilmelder sig", labeldistance=2.5, minlen=2, weight=2];
  Activities -> Registrations [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..*", label="aktivitet har tilmeldinger", labeldistance=2.5, minlen=2, weight=5];
}
